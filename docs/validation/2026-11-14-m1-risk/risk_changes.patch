+void test_exact_position_limit_without_floating_rounding() {
+    MarketManager markets(4);
+    PreTradeRisk risk;
+    risk.bind(markets);
+    const Symbol symbol("AAPL");
+    risk.set_position(symbol, std::numeric_limits<int64_t>::max() - 1);
